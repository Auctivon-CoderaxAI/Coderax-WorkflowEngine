{
  "name": "@coderax/sdk",
  "version": "1.2.0",
  "private": true,
  "description": "Typed Coderax WorkflowEngine client: handshake, chat (JSON and SSE), work, discovery, tasks, artifacts, schedules, memory, permissions, notifications, events and health.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "default": "./dist/compat.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@coderax/contracts": "*",
    "zod": "^3.25.67"
  }
}
