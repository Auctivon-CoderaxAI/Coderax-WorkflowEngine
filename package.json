{
  "name": "coderax-workflow-engine",
  "version": "0.1.0",
  "private": true,
  "description": "CoderaxAI's independent cloud-native intelligence, agent orchestration, durable workflow execution, model routing, and integration engine.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "gate": "node dist/scripts/run-gates.js",
    "gates": "npm run build && node dist/scripts/run-gates.js all",
    "test:unit": "npm run build && node --test \"dist/tests/unit/*.test.js\"",
    "test:contract": "npm run build && node --test \"dist/tests/contract/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/tests/integration/*.test.js\"",
    "test:security": "npm run build && node --test \"dist/tests/security/*.test.js\"",
    "test:adversarial": "npm run build && node --test \"dist/tests/adversarial/*.test.js\"",
    "test:architecture": "npm run build && node --test \"dist/tests/architecture/*.test.js\" && node dist/scripts/check-architecture.js",
    "test:artifacts": "npm run build && node --test \"dist/tests/artifacts/*.test.js\"",
    "test:e2e": "npm run build && node --test \"dist/tests/e2e/*.test.js\"",
    "test:live": "npm run build && node --test \"dist/tests/live/*.test.js\"",
    "openapi:write": "npm run build && node dist/scripts/write-openapi.js",
    "openapi:check": "npm run build && node dist/scripts/check-openapi.js",
    "check:architecture": "npm run build && node dist/scripts/check-architecture.js",
    "check:audit": "npm run build && node dist/scripts/check-audit.js",
    "verify": "npm run build && node dist/scripts/run-gates.js all && node dist/scripts/run-gates.js coverage"
  },
  "dependencies": {
    "@coderax/contracts": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "mongodb": "^7.9.1",
    "typescript": "^5.9.3"
  }
}
