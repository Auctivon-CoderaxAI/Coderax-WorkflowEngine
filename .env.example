# Transport and identity
CODERAX_ENGINE_HOST=127.0.0.1
CODERAX_ENGINE_PORT=8788
CODERAX_OWNER_ID=owner
# Name of the variable that holds the owner token; the token itself is never
# committed. Generate it with: openssl rand -hex 32
CODERAX_OWNER_TOKEN_ENV=CODERAX_OWNER_TOKEN
CODERAX_OWNER_TOKEN=

# Zero-cost inference endpoint (OpenAI-compatible). Leave unset and Coderax
# Native reports `not_configured` instead of routing anywhere paid.
CODERAX_INFERENCE_BASE_URL=
CODERAX_INFERENCE_KEY=

# Engine persistence. `memory` loses state on restart. `mongo` stores leases,
# tasks, conversations, messages, memory, notifications, and durable artifacts
# (metadata, immutable versions and content-addressed chunks) in MongoDB.
# Artifact uploads are refused with 503 storage_unavailable under `memory`:
# the engine will not accept a file it cannot keep across a restart.
# CODERAX_MONGODB_URI holds the connection string by default. Set
# persistence.uriEnv to read it from a different variable. Never commit the
# connection string.
# Mongo mode requires the optional mongodb Node driver (5.7 or later) and a
# reachable collection. Remote connections require TLS (tls=true, or the SRV
# default). Without TLS, use a single loopback host or a Unix socket; the
# connector uses direct mode and does not discover other members.
# Startup fails rather than falling back to memory.
CODERAX_PERSISTENCE_DRIVER=memory
CODERAX_MONGODB_URI=

# Cloud browser provider token. Only read when browsers.enabled is true and
# browsers.provider is "http"; the token is sent as a bearer header and is never
# placed in a URL, a receipt or an error. Leave unset and every browser session
# fails closed with `engine_not_configured`.
CODERAX_BROWSER_TOKEN=

# Optional OpenCode server this engine talks to over HTTP. The engine never spawns
# or bundles one, and Coderax Native does not depend on it. A remote endpoint that
# carries the password must be HTTPS; a loopback endpoint may be plaintext.
# Startup fails rather than accepting an endpoint it cannot trust.
CODERAX_OPENCODE_URL=
CODERAX_OPENCODE_PASSWORD=

# Optional embeddings endpoint for knowledge retrieval. All three are required to
# enable it; without them retrieval is lexical and says so. The key is read by
# name and is never logged or placed in a URL. A remote endpoint must be HTTPS.
CODERAX_EMBEDDINGS_URL=
CODERAX_EMBEDDINGS_KEY=
CODERAX_EMBEDDINGS_MODEL=

# Optional JSON configuration file (env wins over file values)
CODERAX_ENGINE_CONFIG=
