# Transport and identity
CODERAX_ENGINE_HOST=127.0.0.1
CODERAX_ENGINE_PORT=8788
CODERAX_OWNER_ID=owner
# Name of the variable that holds the owner token; the token itself is never
# committed. Generate it with: openssl rand -hex 32
CODERAX_OWNER_TOKEN_ENV=CODERAX_OWNER_TOKEN
CODERAX_OWNER_TOKEN=

# Zero-cost inference endpoint (OpenAI-compatible). Leave unset and Coderax
# Native reports `not_configured` instead of routing anywhere paid.
CODERAX_INFERENCE_BASE_URL=
CODERAX_INFERENCE_KEY=

# Optional JSON configuration file (env wins over file values)
CODERAX_ENGINE_CONFIG=
